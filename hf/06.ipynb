    "# 3) title analysis\n",
    "\n",
    "# repeated titles\n",
    "title_counts = (\n",
    "    poems_df[poems_df[\"title\"].str.strip() != \"\"][\"title\"]\n",
    "    .value_counts()\n",
    "    .rename_axis(\"title\")\n",
    "    .reset_index(name=\"count\")\n",
    ")\n",
    "\n",
    "print(\"Repeated titles (count > 1):\")\n",
    "display(title_counts[title_counts[\"count\"] > 1].head(20))\n",
    "\n",
    "# most frequent words in titles\n",
    "title_tokens = []\n",
    "for t in poems_df[\"title\"]:\n",
    "    title_tokens.extend(tokenize_hu(t))\n",
    "\n",
    "title_word_freq = Counter(title_tokens)\n",
    "print(\"\\nTop title words:\")\n",
    "for w, c in title_word_freq.most_common(20):\n",
    "    print(f\"{w:20s} {c}\")\n",
    "\n",
    "# relationship between title length and poem length\n",
    "corr_df = poems_df[(poems_df[\"title_word_len\"] > 0) & (poems_df[\"content_word_len\"] > 0)].copy()\n",
    "print(\"\\nCorrelation between title word count and content word count:\",\n",
    "      round(corr_df[\"title_word_len\"].corr(corr_df[\"content_word_len\"]), 3))\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "plt.scatter(corr_df[\"title_word_len\"], corr_df[\"content_word_len\"], alpha=0.35)\n",
    "plt.xlabel(\"Title word count\")\n",
    "plt.ylabel(\"Poem word count\")\n",
    "plt.title(\"Title length vs poem length\")\n",
    "plt.grid(alpha=0.2)\n",
    "plt.show()"
   ]
  }

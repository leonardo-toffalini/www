   "source": [
    "# 1) frequency analysis over words and phrases\n",
    "\n",
    "hungarian_stopwords = {\n",
    "    \"a\", \"az\", \"és\", \"hogy\", \"is\", \"ha\", \"de\", \"mint\", \"már\", \"meg\", \"nem\", \"én\", \"te\", \"ő\",\n",
    "    \"mi\", \"ti\", \"ők\", \"egy\", \"egyik\", \"vagy\", \"van\", \"volt\", \"lesz\", \"se\", \"s\", \"ami\", \"mert\",\n",
    "    \"ki\", \"be\", \"el\", \"fel\", \"le\", \"át\", \"rá\", \"ide\", \"oda\", \"itt\", \"ott\", \"csak\", \"még\",\n",
    "    \"html\"\n",
    "}\n",
    "\n",
    "def tokenize_hu(text):\n",
    "    text = text.lower()\n",
    "    # Keep Hungarian accented letters too\n",
    "    text = re.sub(r\"[^a-záéíóöőúüű\\s]\", \" \", text)\n",
    "    tokens = [t for t in text.split() if len(t) >= 3 and t not in hungarian_stopwords]\n",
    "    return tokens\n",
    "\n",
    "def tokenize_hu_long_words(text):\n",
    "    text = text.lower()\n",
    "    # Keep Hungarian accented letters too\n",
    "    text = re.sub(r\"[^a-záéíóöőúüű\\s]\", \" \", text)\n",
    "    tokens = [t for t in text.split() if len(t) >= 6 and t not in hungarian_stopwords]\n",
    "    return tokens\n",
    "\n",
    "all_tokens = []\n",
    "all_tokens_long = []\n",
    "all_bigrams = []\n",
    "\n",
    "for content in poems_df[\"content\"]:\n",
    "    tokens = tokenize_hu(content)\n",
    "    tokens_long = tokenize_hu_long_words(content)\n",
    "    all_tokens.extend(tokens)\n",
    "    all_tokens_long.extend(tokens_long)\n",
    "    all_bigrams.extend(zip(tokens, tokens[1:]))\n",
    "\n",
    "word_freq = Counter(all_tokens)\n",
    "long_word_freq = Counter(all_tokens_long)\n",
    "bigram_freq = Counter(all_bigrams)\n",
    "\n",
    "print(\"Top 25 words:\")\n",
    "for w, c in word_freq.most_common(25):\n",
    "    print(f\"{w:20s} {c}\")\n",
    "    \n",
    "print(\"\\nTop 25 long words (>5 chars):\")\n",
    "for w, c in long_word_freq.most_common(25):\n",
    "    print(f\"{w:20s} {c}\")\n",
    "\n",
    "print(\"\\nTop 20 phrases (bigrams):\")\n",
    "for (w1, w2), c in bigram_freq.most_common(20):\n",
    "    print(f\"{w1 + ' ' + w2:20s} {c}\")"
   ]
  },

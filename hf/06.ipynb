      "cell_type": "code",
      "execution_count": 5,
      "id": "35092f14",
      "metadata": {},
      "outputs": [],
      "source": [
        "def partition_by_sign(vec, nodes):\n",
        "    pos = [n for n, x in zip(nodes, vec) if x >= 0]\n",
        "    neg = [n for n, x in zip(nodes, vec) if x < 0]\n",
        "    return [set(pos), set(neg)]\n",
        "\n",
        "parts_f = partition_by_sign(fiedler, nodes_u)"
      ]
    },

   "source": [
    "# 2) trends by year\n",
    "\n",
    "trend_df = poems_df.dropna(subset=[\"year\"]).copy()\n",
    "trend_df[\"year\"] = trend_df[\"year\"].astype(int)\n",
    "\n",
    "# lexical richness = unique tokens / total tokens\n",
    "\n",
    "def lexical_richness(text):\n",
    "    tokens = tokenize_hu(text)\n",
    "    if not tokens:\n",
    "        return np.nan\n",
    "    return len(set(tokens)) / len(tokens)\n",
    "\n",
    "trend_df[\"lexical_richness\"] = trend_df[\"content\"].apply(lexical_richness)\n",
    "\n",
    "year_stats = (\n",
    "    trend_df.groupby(\"year\", as_index=False)\n",
    "    .agg(\n",
    "        poems=(\"title\", \"count\"),\n",
    "        avg_chars=(\"content_char_len\", \"mean\"),\n",
    "        avg_words=(\"content_word_len\", \"mean\"),\n",
    "        avg_lexical_richness=(\"lexical_richness\", \"mean\"),\n",
    "    )\n",
    "    .sort_values(\"year\")\n",
    ")\n",
    "\n",
    "display(year_stats.tail(15))\n",
    "\n",
    "fig, axes = plt.subplots(3, 1, figsize=(11, 12), sharex=True)\n",
    "\n",
    "axes[0].plot(year_stats[\"year\"], year_stats[\"poems\"], marker=\"o\")\n",
    "axes[0].set_ylabel(\"Poems\")\n",
    "axes[0].set_title(\"Poems per year\")\n",
    "axes[0].grid(alpha=0.25)\n",
    "\n",
    "axes[1].plot(year_stats[\"year\"], year_stats[\"avg_words\"], marker=\"o\", color=\"tab:green\")\n",
    "axes[1].set_ylabel(\"Avg words\")\n",
    "axes[1].set_title(\"Average poem length by year\")\n",
    "axes[1].grid(alpha=0.25)\n",
    "\n",
    "axes[2].plot(year_stats[\"year\"], year_stats[\"avg_lexical_richness\"], marker=\"o\", color=\"tab:red\")\n",
    "axes[2].set_ylabel(\"Avg lexical richness\")\n",
    "axes[2].set_xlabel(\"Year\")\n",
    "axes[2].set_title(\"Lexical richness trend by year\")\n",
    "axes[2].grid(alpha=0.25)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },

    "def actions_from_dataset(dataset, index):\n",
    "    for i, row in enumerate(dataset):\n",
    "        yield {\n",
    "            \"_index\": index,\n",
    "            \"_id\": i,\n",
    "            \"_source\": {\n",
    "                \"title\": row.get(\"title\", \"\"),\n",
    "                \"date\": row.get(\"date\", \"\"),\n",
    "                \"content\": row.get(\"content\", \"\")\n",
    "            }\n",
    "        }\n",
    "\n",
    "success, failed = 0, 0\n",
    "for ok, _ in helpers.streaming_bulk(es, actions_from_dataset(ds, index_name), chunk_size=200):\n",
    "    if ok:\n",
    "        success += 1\n",
    "    else:\n",
    "        failed += 1\n",
    "\n",
    "es.indices.refresh(index=index_name)\n",
    "print({\"indexed\": success, \"failed\": failed})"
   ]
